node_modules/
dist/

# Reproducible intermediate Blender builds; final packed source is tracked.
/art/characters/kenji/kenji-source.blend
/art/characters/kenji/kenji-review.blend
*.blend1
/art/izakaya/supplied/exterior-uncompressed.glb

/art/characters/yui/yui-source.blend
/art/characters/yui/yui-review.blend

/art/tea-house/supplied/exterior-uncompressed.glb
/art/yuri-home/japanese_residential_home_02.glb

# (Johansson's and Thuan's .blend files were ignored for an older pipeline whose scripts are no longer here; their head
# sculpts and rigged characters, made by tools/blender/build-<name>-head.py, are kept like everybody else's: the tests
# read them. Blender's own backups, *.blend1, are not kept.)
__pycache__/

# Unpublished Studio drafts and the active writer's lock stay local.
/data/studio/draft/
/data/studio/.lock

# Sakura restroom: the CAD tessellation Blender reads; rebuilt by tools/cad/build-sakura-restroom-cad.py.
/art/sakura-restroom/cad/parts/

# The game-built character exported for a Blender review sheet; rebuilt by tools/blender/build-<name>-head.py --sheet.
/art/characters/*/review/*.glb

# The whole cast as rigged Blender characters: 32 MB that tools/blender/rig-cast.py makes again.
/output/rigged-cast/
# (the drink's rig, its .blend and its renders: tools/blender/drink-can.py makes them again; its sheets are kept in art/)
/output/drink-can/
# The principles audit's report (tools/animation-audit.mjs rewrites it in about 95 s; the baseline in tests/ is what is kept)
/output/animation-audit/

# Scratch renders and logs made while working (tools write review images to output/ by default): only what is
# already tracked under output/ stays; new loose files at its top level are not kept.
/output/*.png
/output/*.log
